{
    "compilerOptions": {
        "module": "commonjs",
        "target": "es2022",
        "moduleResolution": "node",
        "esModuleInterop": true,
        "strict": false,
        "skipLibCheck": true,
        "resolveJsonModule": true,
        "types": ["node", "@wdio/types", "@wdio/mocha-framework", "expect-webdriverio", "webdriverio/async"]
    },
    "include": ["**/*.ts"]
}
