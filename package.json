    "@tauri-apps/cli": "^2.11.0",
    "@types/mocha": "^10.0.10",
    "@wdio/cli": "^7.40.0",
    "@wdio/local-runner": "^7.40.0",
    "@wdio/mocha-framework": "^7.40.0",
    "@wdio/spec-reporter": "^7.40.0",
    "@wdio/types": "^7.40.0",
